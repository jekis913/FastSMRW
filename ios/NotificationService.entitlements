<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Same shared keychain group as the app, so this extension can read the
	     Web Push keypair (WebPushKeys) to decrypt an incoming push. -->
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)me.masonasons.FastSMRW.push</string>
	</array>
</dict>
</plist>
